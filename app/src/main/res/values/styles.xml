<resources>
    <!-- Otros estilos -->
    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/white</item> <!-- Fondo blanco -->
        <item name="boxStrokeColor">@color/black</item> <!-- Borde negro -->
    </style>

    <!-- Estilo para imagen circular -->
    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ToolbarTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ESTILO CORRECTO PARA POPUPMENU CON TEXTO NEGRO VISIBLE -->
    <style name="MyPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@android:color/white</item>
        <item name="android:textColor">#000000</item> <!-- NEGRO PURO -->
        <item name="android:itemBackground">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:popupElevation">8dp</item>

        <!-- FUERZA EL COLOR DEL TEXTO (CRUCIAL) -->
        <item name="android:color">@android:color/black</item>
    </style>



</resources>